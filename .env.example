# Sólo en el servidor (función de Vercel). Nunca en el cliente.
GROQ_API_KEY=
# Opcional. Por defecto openai/gpt-oss-120b; openai/gpt-oss-20b es el doble de rápido.
# GROQ_MODEL=openai/gpt-oss-20b

# Base de datos (Neon, Postgres). Connection string del proyecto; el esquema está en db/schema.sql.
DATABASE_URL=
# Webhook de Make que avisa por Telegram cuando una partida entra al top 10. Opcional.
MAKE_WEBHOOK_URL=
# Si el webhook de Make tiene API key, va en el header x-make-apikey. Opcional.
MAKE_WEBHOOK_KEY=
